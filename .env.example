# -----------------------------
# Bright Data
# -----------------------------
# Get your API key from Bright Data Control Panel:
# https://brightdata.com/cp/setting/users
BRIGHTDATA_API_KEY=""

# SERP API zone (example from Bright Data docs). Create/choose a SERP zone in your account.
BRIGHTDATA_SERP_ZONE="serp_api1"

# Optional: Set default country for SERP requests (two-letter code like us, gb, ca)
BRIGHTDATA_COUNTRY="us"

# -----------------------------
# Web Archive (optional)
# -----------------------------
# Uses the same BRIGHTDATA_API_KEY. No extra setting required.

# -----------------------------
# Answer engine scraper (optional)
# -----------------------------
# Default dataset_id taken from Bright Data "AI Answer Engine Scrapers" example for ChatGPT Search.
# You can change this if Bright Data updates IDs or if you want Gemini/Perplexity/Grok/Copilot.
BRIGHTDATA_CHATGPT_SEARCH_DATASET_ID="gd_m7aof0k82r803d5bjm"

# -----------------------------
# LLM (optional, for synthesis)
# -----------------------------
# Option A: OpenAI-compatible Chat Completions endpoint.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Option B: Ollama (local) — no API key required if running locally.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"

# -----------------------------
# Google Gemini
# -----------------------------
GOOGLE_API_KEY=""
GOOGLE_MODEL="gemini-3-flash-preview"
